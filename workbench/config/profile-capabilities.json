{
  "schema_version": 1,
  "kind": "declarative_profile_capability_policy",
  "status": "requires_target_discovery",
  "enforced_by_workbench_controller": false,
  "notes": "Capability names are Workbench concepts, not actual MCP tool names. After a connection and project binding are configured, the default effective execution policy auto-allows every discovered and bound capability without a per-call MCP permission dialog. Role and stage capabilities guide routing/context; they do not create repetitive approval prompts.",
  "selection_rule": "discovered_capabilities intersect enabled_project_binding intersect current_resource_scope intersect effective_execution_policy; profile and stage metadata select useful tools but do not narrow authorization unless the user explicitly disables a capability or an explicit target rule blocks it",
  "defaults": {
    "mode": "auto_allow_bound",
    "allow_unlisted_discovered_bound_capabilities": true,
    "allow_unknown_tool_effects_after_explicit_connection_binding": true,
    "inherit_effective_policy_in_sessions_and_subagents": true,
    "per_call_mcp_permission_prompt": false,
    "mutating_actions": "auto_allow_under_effective_project_binding_and_record_target_operation_and_result",
    "production_destructive_actions": "follow_explicit_target_policy_block_or_allow_without_ad_hoc_permission_modal",
    "revoke": "disable_connection_or_capability_blocks_new_dispatch_and_versions_policy_revision",
    "missing_required_capability": "block_only_the_affected_required_action",
    "unsupported_isolated_mode": "disable_native_delegation_and_use_interactive_mode_with_explicit_limits",
    "repository_setup": "only_when_user_explicitly_requests_new_project_setup"
  },
  "provider_hints": {
    "Git": [
      "git.read",
      "git.branch",
      "git.commit",
      "git.push",
      "git.pr.read",
      "git.pr.write",
      "git.merge"
    ],
    "Jenkins": [
      "ci.read",
      "ci.run"
    ],
    "OpenShift": [
      "cluster.read",
      "cluster.apply"
    ],
    "Confluence": [
      "knowledge.read",
      "knowledge.write"
    ],
    "Sprut": [
      "security.scan.read",
      "security.scan.run"
    ]
  },
  "provider_notes": {
    "Sprut": "User-confirmed purpose: software composition analysis of dependency/library versions and vulnerabilities. Do not bind Sprut to tracker or SAST without separate evidence.",
    "all": "Provider names are discovery hints. Exact server identity, tool names, schemas, effects and resource permissions must come from the target session. A hint does not establish that a provider offers every listed action."
  },
  "read_only_candidates": [
    "repo.read",
    "git.read",
    "git.pr.read",
    "knowledge.read",
    "ci.read",
    "cluster.read",
    "browser.inspect",
    "data.read",
    "metrics.read",
    "tracker.read",
    "security.scan.read"
  ],
  "potentially_mutating_capabilities": [
    "repo.write",
    "git.branch",
    "git.commit",
    "git.push",
    "git.pr.write",
    "git.merge",
    "knowledge.write",
    "ci.run",
    "cluster.apply",
    "test.run",
    "data.migrate",
    "tracker.write",
    "security.scan.run"
  ],
  "classification_notes": {
    "read_only_candidates": "This list optimizes discovery, UI grouping and low-cost context. It is not a permission allowlist. Capability spelling and MCP readOnly annotations alone do not prove actual effects; the operation ledger still records the observed target, effect and result.",
    "test.run": "Tests can write local files, start services or contact shared environments. The bound connection policy auto-allows the call without a per-call prompt; workflow rules still require an appropriate target and truthful result.",
    "security.scan.run": "Starting SCA analysis is distinct from reading an existing report. Check whether it uploads source/manifests, creates a scan, consumes service resources or changes server state."
  },
