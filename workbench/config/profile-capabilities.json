  "inventory_cache": {
    "suggested_local_path": "<TargetRoot>/workbench-memory/mcp/tool-inventory.local.json",
    "reuse": "Reuse verified inventory while build, server identity, available-tool schemas, relevant permissions and resource scope match its fingerprint.",
    "refresh_triggers": [
      "runtime_or_server_changed",
      "tool_schema_changed",
      "permissions_or_scope_changed",
      "tool_missing_or_denied",
      "explicit_refresh"
    ],
    "secrets": "Never persist credentials or hash raw secret-bearing settings as inventory. Fingerprint a normalized non-secret projection."
  },
  "verified_bindings": {
    "suggested_local_path": "<TargetRoot>/workbench-memory/mcp/bindings.local.json",
    "base_contract": "config/bindings.example.json",
    "actual_tool_names": null,
    "unverified_bindings_status": "unconfigured"
  },
  "native_adapter": {
    "target_version": "26.9.75",
    "target_verified_here": false,
    "agent_path_pattern": ".gigacode/agents/workbench-<profile>.md",
    "documented_frontmatter_fields": [
      "name",
      "description",
      "model",
      "approvalMode",
      "tools",
      "disallowedTools"
    ],
    "required_for_delegation": [
      "verified_supported_format",
      "verified_parent_tool_inheritance_or_explicit_all_bound_tools",
      "verified_no_prompt_effective_policy",
      "verified_resource_scope"
    ],
    "tools_field": "Prefer the verified native representation that inherits every discovered tool in the effective project binding. If this target requires an explicit list, render every bound tool name; do not narrow it by role.",
    "disallowed_tools_field": "Use only for an explicit central disable or target policy block.",
    "permission_caveat": "Verify the effective parent and child policy on the target build. A role hint does not narrow authorization, and a UI label alone does not prove that per-call prompts are disabled."
  },
  "context_read_policy": {
    "capabilities": [
      "repo.read",
      "git.read",
      "git.pr.read",
      "knowledge.read",
      "ci.read",
      "cluster.read",
      "browser.inspect",
      "data.read",
      "metrics.read",
      "tracker.read",
      "security.scan.read"
    ],
    "requires": "actual task relevance, verified read-only effect, allowed resource and current authorization; record why context is needed",
    "not_authorization": "This is a context-selection hint, not an authorization boundary. Writes and other bound effects remain available under the central effective policy."
  },
  "service_operations": {
    "owner": "parent host",
    "scope": "local fixed Workbench journal, artifact and memory commands within configured paths",
    "not_profile_mcp_access": "Does not give subagents a general shell or external write tools; they return structured facts to the parent for recording."
  }
}
