{
  "name": "gigacode-workbench",
  "version": "1.2.0",
  "target": {
    "product": "GigaCode CLI",
    "user_version": "26.9.75",
    "runtime_verified": false
  },
  "controller": {
    "entrypoint": "workbench.ps1 (created from source/workbench.txt)",
    "mode": "interactive-sequential",
    "automatic_mcp_execution": false,
    "powershell_min": "5.1",
    "requires_full_language": true
  },
  "system_prompt": "SYSTEM_PROMPT.md",
  "bootstrap": "BOOTSTRAP.md",
  "workflow_format": "workbench-v1-not-native-gigacode",
  "profiles": [
    "analyst",
    "backend",
    "devops",
    "diagnostics",
    "frontend",
    "gigacode-ui",
    "qa",
    "reviewer",
    "spec"
  ],
  "workflows": [
    "acceptance",
    "backend-feature",
    "behavior-change",
    "bugfix",
    "data-migration",
    "dependency-upgrade",
    "design-audit",
    "design-system",
    "discovery",
    "documentation",
    "frontend-feature",
    "gigacode-ui-diagnostics",
    "gigacode-ui-feature",
    "incident",
    "infrastructure",
    "onboarding",
    "performance",
    "pull-request",
    "quick-answer",
    "quick-backend",
    "quick-doc",
    "quick-frontend",
    "refactor",
    "release",
    "retrospective",
    "review",
    "security-review",
    "specification",
    "ux-design"
  ],
  "config_examples_are_native_settings": false,
  "distribution": "text-source-and-static-graphics",
  "self_setup": "SETUP-AGENT.md",
  "shared_memory": "outside bundle at <TargetRoot>/workbench-memory",
  "ui_start": "START-GIGACODE-UI.md",
  "start_here": "START-HERE.md",
  "post_setup_handoff": "docs/POST_SETUP_HANDOFF.md",
  "startup_execution": "agent instructions; no automatic runtime hook"
}
