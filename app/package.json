{
  "name": "gigacode-workbench-ui",
  "version": "0.5.0-preview.1",
  "private": true,
  "description": "A local desktop workspace for ACP coding agents",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node build-electron.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && npm run prepare:ide-package && electron-builder --dir",
    "dist:win": "npm run build && npm run prepare:ide-package && electron-builder --win nsis portable",
    "dist:mac": "npm run build && npm run prepare:ide-package && electron-builder --mac dir",
    "test:live": "vitest run --config vitest.live.config.ts",
    "bundle:cli": "node tools/bundle-cli.mjs",
    "format": "prettier --write src electron shared tests *.ts *.mjs",
    "test:ui": "node tools/test-modal-ui.mjs && node tools/test-composer-ui.mjs && node tools/test-settings-ui.mjs && node tools/test-operations-review-ui.mjs && node tools/test-panel-boundary-ui.mjs",
    "setup:ide": "node tools/setup-ide.mjs",
    "test:ide": "npm run build && node tools/test-ide-live.mjs",
    "prepare:ide-package": "node tools/package-ide.mjs",
    "test:ide:languages": "npm run build && node tools/test-ide-live.mjs --languages",
    "test:chat": "npm run build && node tools/test-chat-live.mjs",
    "test:database": "npm run build && node tools/test-database-live.mjs",
    "test:database:ui": "npm run build && node tools/test-database-live.mjs --ui",
    "test:operations": "node tools/test-operations-live.mjs",
    "test:operations:ui": "npm run build && node tools/test-operations-live.mjs --ui"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@qwen-code/qwen-code": "0.25.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.20.0",
    "iconv-lite": "0.7.2",
    "pg": "8.23.1",
    "pg-copy-streams": "7.0.0",
    "pg-query-stream": "4.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "saxes": "6.0.0",
    "sql-formatter": "15.9.0",
    "undici": "8.11.2",
    "yaml": "2.9.1",
    "yauzl": "3.2.1",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "^1.59.0",
    "prettier": "3.9.9",
    "typescript": "^6.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "io.github.wuller1.gigacode-workbench",
    "productName": "GigaCode Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "third-party/**/*"
    ],
    "extraResources": [
      {
        "from": "../workbench",
        "to": "workbench",
        "filter": [
          "**/*",
          "!.DS_Store"
        ]
      },
      {
        "from": "../docs/suite",
        "to": "docs/suite",
        "filter": [
          "**/*",
          "!.DS_Store"
        ]
      },
      {
        "from": "../suite/implementation-plan.json",
        "to": "suite/implementation-plan.json"
      },
      {
        "from": "../design/suite-workspace-prototype.html",
        "to": "design/suite-workspace-prototype.html"
      },
      {
        "from": "../ui-kit",
        "to": "ui-kit",
        "filter": [
          "**/*",
          "!node_modules{,/**/*}",
          "!dist{,/**/*}",
          "!release{,/**/*}",
          "!.DS_Store"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "../docs/THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "runtime",
        "to": "cli",
        "filter": [
          "**/*",
          "!ide-node{,/**/*}",
          "!ide-tools{,/**/*}",
          "!.ide-package{,/**/*}"
        ]
      },
      {
        "from": "runtime/.ide-package",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "build/icon.png"
    }
  },
  "overrides": {
    "sharp": "0.35.5",
    "@electron/get": "5.1.0"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0"
  },
  "author": "wuller1"
}
