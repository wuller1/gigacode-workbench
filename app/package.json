{
  "name": "gigacode-workbench-ui",
  "version": "0.1.0",
  "private": true,
  "description": "A local desktop workspace for ACP coding agents",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node build-electron.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "dist:mac": "npm run build && electron-builder --mac dir",
    "test:live": "vitest run --config vitest.live.config.ts",
    "bundle:cli": "node tools/bundle-cli.mjs",
    "format": "prettier --write src electron shared tests *.ts *.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@qwen-code/qwen-code": "0.25.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "^1.59.0",
    "prettier": "3.9.9",
    "typescript": "^6.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "io.github.wuller1.gigacode-workbench",
    "productName": "GigaCode Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../workbench",
        "to": "workbench",
        "filter": [
          "**/*",
          "!.DS_Store"
        ]
      },
      {
        "from": "../docs/THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "runtime",
        "to": "cli",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "build/icon.png"
    }
  },
  "overrides": {
    "sharp": "0.35.5",
    "@electron/get": "5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "author": "wuller1"
}
