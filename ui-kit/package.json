{
  "name": "@organization/gigacode-ui-kit",
  "version": "0.0.0-reference",
  "private": true,
  "description": "Typed desktop enterprise components and bounded design recipes for GigaCode",
  "type": "module",
  "sideEffects": [
    "./src/styles/*.css"
  ],
  "files": [
    "dist",
    "brand",
    "icons",
    "tokens",
    "templates",
    "registry",
    "CHANGELOG.md",
    "MIGRATION.md",
    "src",
    "LICENSE",
    "recipes",
    "tools/read-recipe.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./semantic.css": "./src/styles/semantic.css",
    "./components.css": "./src/styles/components.css",
    "./tokens/*": "./tokens/*",
    "./brand/*": "./brand/*",
    "./icons/*": "./icons/*",
    "./templates/*": "./templates/*",
    "./registry/*": "./registry/*",
    "./recipes/*": "./recipes/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:catalog": "node ./tools/check-catalog.mjs",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build && npm run check:catalog",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:desktop": "node tools/test-desktop.mjs"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "restricted",
    "provenance": true
  },
  "license": "Apache-2.0"
}
